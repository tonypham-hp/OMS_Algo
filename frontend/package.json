{
  "name": "frontend",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tokens": "node scripts/gen-tokens.mjs",
    "lint": "eslint . && node scripts/check-colors.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run lint && npm run test && npm run build && npm run test:e2e",
    "screenshots": "playwright test e2e/screenshots.spec.ts --project=desktop-1440",
    "screenshots:dot7": "playwright test e2e/screenshots-dot7.spec.ts --project=desktop-1440",
    "screenshots:dot8a": "playwright test e2e/screenshots-dot8a.spec.ts --project=desktop-1440",
    "screenshots:dot8b": "playwright test e2e/screenshots-dot8b.spec.ts --project=desktop-1440",
    "screenshots:dot9": "playwright test e2e/screenshots-dot9.spec.ts --project=desktop-1440",
    "screenshots:dot10a": "playwright test e2e/screenshots-dot10a.spec.ts --project=desktop-1440",
    "screenshots:dot10b": "playwright test e2e/screenshots-dot10b.spec.ts --project=desktop-1440",
    "perf:workspace": "node scripts/perf-workspace.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^7.0.3",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dockview-react": "8.10.0",
    "lucide-react": "^1.69.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hotkeys-hook": "5.4.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "msw": "^3.0.4",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
